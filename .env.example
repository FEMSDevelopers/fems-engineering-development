# Copied to .env by setup. Local development uses the embedded PostgreSQL (npm run db:local).
DATABASE_URL=postgres://fpl:fpl_dev_password@localhost:54329/fpl
LOCAL_PG_PORT=54329
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
BODY_LIMIT=52428800
# Using Docker Desktop instead (npm run db:up + npm run dev:docker)? Use:
# DATABASE_URL=postgres://fpl:fpl_dev_password@localhost:5432/fpl
